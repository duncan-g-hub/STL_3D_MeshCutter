<Window x:Class="MeshCutter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeshCutter.App"
        xmlns:helix="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        mc:Ignorable="d"
        Title="MeshCutter" Height="550" Width="800" MinHeight="550" MinWidth="600"
        Language="fr-FR">
        
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="4*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        
        
        <Button Content="Open File" Command="{Binding OpenFileCommand}" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,0,10" Height="25"/>
        <TextBlock Text="{Binding FileErrorMessage}" Grid.Row="0" Grid.Column="1" TextAlignment="Left" Margin="5,10" TextWrapping="Wrap"/>

        <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="1">
            <Border Background="#D9D9D9" Margin="2 2 2 2" BorderBrush="#6B6B6B" BorderThickness="1" CornerRadius="2">
                <TextBlock Text="{Binding Informations}" TextAlignment="Left" Margin="5,10" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Margin="0 2">
                <TextBlock Text="Dimensions imprimante : "/>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe X : " Margin="2 0"/>
                    <TextBox Text="{Binding PrintSizeX}" Width="50" Margin="2 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe Y : " Margin="2 0"/>
                    <TextBox Text="{Binding PrintSizeY}" Width="50" Margin="2 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe Z : " Margin="2 0"/>
                    <TextBox Text="{Binding PrintSizeZ}" Width="50" Margin="2 0"/>
                </StackPanel>
            </StackPanel>


            <StackPanel Margin="0 2">
                <TextBlock Text="Marges de l'imprimante : "/>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe X : " Margin="2 0"/> 
                    <TextBox Text="{Binding MarginX}" Margin="2 0" Width="50"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2">
                    <TextBlock Text="Axe Y : " Margin="2 0"/> 
                    <TextBox Text="{Binding MarginY}" Margin="2 0" Width="50"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2">
                    <TextBlock Text="Axe Z : " Margin="2 0"/> 
                    <TextBox Text="{Binding MarginZ}" Margin="2 0" Width="50"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Margin="0 2">
                <TextBlock Text="Nombre de pieces par axe : "></TextBlock>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe X : " Margin="2 0"/> 
                    <TextBlock Text="{Binding PiecesX}" Margin="2 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe Y : " Margin="2 0"/> 
                    <TextBlock Text="{Binding PiecesY}" Margin="2 0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal"  Margin="0 2"> 
                    <TextBlock Text="Axe Z : " Margin="2 0"/> 
                    <TextBlock Text="{Binding PiecesZ}" Margin="2 0"/>
                </StackPanel>
            </StackPanel>
        
            <TextBlock Text="{Binding PrintErrorMessage}" TextAlignment="Left" Margin="0,7" TextWrapping="Wrap"/>

        </StackPanel>

         
        
        
        <helix:HelixViewport3D x:Name="Visualizer3D" Grid.Row="1" Grid.Column="0">
            <helix:DefaultLights/>
            <!-- <helix:BoxVisual3D Length="60" Width="30" Height="90" Center="0,0,0">
            </helix:BoxVisual3D> -->

            <helix:MeshGeometryVisual3D MeshGeometry="{Binding Mesh}" />
        </helix:HelixViewport3D>
    </Grid>
</Window>
