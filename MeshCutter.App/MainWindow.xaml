<Window x:Class="MeshCutter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeshCutter.App"
        xmlns:helix="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        mc:Ignorable="d"
        Title="MeshCutter" Height="500" Width="800" MinHeight="500" MinWidth="600">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        
        <Button Content="Open File" Click="OpenFileButton_Click" Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,10" Height="25"/>
        
        <helix:HelixViewport3D x:Name="Visualizer3D" Grid.Row="1">
            <helix:DefaultLights/>
            <!-- <helix:BoxVisual3D Length="60" Width="30" Height="90" Center="0,0,0">
            </helix:BoxVisual3D> -->

            <helix:MeshGeometryVisual3D x:Name="DisplayedModel" />
        </helix:HelixViewport3D>
    </Grid>
</Window>
