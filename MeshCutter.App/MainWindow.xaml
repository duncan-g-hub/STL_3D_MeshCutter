<Window x:Class="MeshCutter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MeshCutter.App"
        xmlns:helix="clr-namespace:HelixToolkit.Wpf;assembly=HelixToolkit.Wpf"
        mc:Ignorable="d"
        Title="MeshCutter" Height="550" Width="800" MinHeight="550" MinWidth="600">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        
        <Button Content="Open File" Click="OpenFileButton_Click" Grid.Row="0" Grid.Column="0" HorizontalAlignment="Center" Margin="0,0,0,10" Height="25"/>

        <Border Grid.Row="1" Grid.Column="1" Background="#D9D9D9" Margin="10 2 2 2" BorderBrush="#6B6B6B" BorderThickness="1" CornerRadius="2">
            <StackPanel>
                <TextBlock x:Name="ModelInfos" TextAlignment="Left" Margin="5,10" TextWrapping="Wrap">Informations : </TextBlock>
            </StackPanel>
        </Border>
        
        <helix:HelixViewport3D x:Name="Visualizer3D" Grid.Row="1" Grid.Column="0">
            <helix:DefaultLights/>
            <!-- <helix:BoxVisual3D Length="60" Width="30" Height="90" Center="0,0,0">
            </helix:BoxVisual3D> -->

            <helix:MeshGeometryVisual3D x:Name="DisplayedModel" />
        </helix:HelixViewport3D>
    </Grid>
</Window>
